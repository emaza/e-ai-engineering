# Proveedor LLM (solo es obligatoria la key del proveedor seleccionado)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai

# Modelo. Si se deja vacío: gpt-4o-mini (openai) o claude-haiku-4-5 (anthropic)
LLM_MODEL=gpt-4o-mini

# Aplicación
APP_ENV=development
LOG_LEVEL=DEBUG

# Caché exact-match de respuestas del LLM (en memoria, se pierde al reiniciar)
CACHE_ENABLED=true
CACHE_TTL_SECONDS=86400
CACHE_MAX_ENTRIES=256
