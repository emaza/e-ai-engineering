# Copia este archivo a .env y rellena al menos una de las dos keys.
# Si falta una, el notebook se salta las celdas de ese proveedor.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Modelos (opcionales; estos son los valores por defecto)
OPENAI_MODEL=gpt-4o-mini
# claude-haiku-5-5 es mucho más barato ($0.10 / $0.50 por 1M tokens)
ANTHROPIC_MODEL=claude-opus-5-5
